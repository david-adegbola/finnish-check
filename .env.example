# Copy to .env (git-ignored) and fill in ONE of the two keys. Without a key the app runs in MOCK MODE.
# Anthropic's API directly (keys start with sk-ant-)
ANTHROPIC_API_KEY=
# ...or OpenRouter, which forwards requests to Claude (keys start with sk-or-)
OPENROUTER_API_KEY=
# Optional. Anthropic-style names also work with OpenRouter (claude-haiku-5-5 -> anthropic/claude-haiku-5.5)
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (Anthropic API only)
LLM_EFFORT=low
# Set to "mock" to force mock mode even when a key is set
LLM_MODE=
